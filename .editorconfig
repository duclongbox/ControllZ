root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{ts,tsx,js,jsx,mjs,cjs,json,yml,yaml,html,css}]
indent_size = 2

[*.java]
indent_size = 4

[*.{c,cc,cpp,mm,h,hpp,cmake}]
indent_size = 4

[CMakeLists.txt]
indent_size = 4

# Trailing whitespace is a hard line break in Markdown — don't strip it.
[*.md]
indent_size = 2
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
