{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://remotehost.dev/schemas/heartbeatAck.schema.json",
  "title": "HeartbeatAck",
  "description": "Server -> client. Reply to `heartbeat`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "serverTime"],
  "properties": {
    "type": {
      "const": "heartbeatAck"
    },
    "serverTime": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC. Lets a client notice clock skew against `pairCodeIssued.expiresAt`."
    }
  }
}
