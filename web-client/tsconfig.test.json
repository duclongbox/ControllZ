{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    // `types` replaces rather than extends the app project's list, so
    // "vite/client" must be repeated here: tests import from src/, which pulls
    // those modules into THIS program, and without it every `*.module.css`
    // import in a component reachable from a test fails to resolve.
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom", "node"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  // src/vite-env.d.ts carries the globals vite injects (__APP_VERSION__). The
  // app project picks it up from `include: ["src"]`; this one reaches src only
  // through imports, which do not pull in ambient declaration files.
  "include": ["tests", "e2e", "src/vite-env.d.ts"]
}
